# LINE Messaging API Credentials
LINE_CHANNEL_SECRET=請填入你的_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=請填入你的_Channel_Access_Token

# Google Gemini API Key
GEMINI_API_KEY=請填入你的_Gemini_API_Key

# Firebase Admin SDK Configuration
# 下載的 Firebase 服務帳戶私密金鑰檔案路徑 (例如放在專案根目錄的 serviceAccountKey.json)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# PRO 權限：可在群組輸入 /解鎖會議 的管理員 LINE userId（逗號分隔）
PRO_ADMIN_USER_IDS=
# 永久開通 PRO 的群組 ID（逗號分隔，伺服器重啟後仍有效）
PRO_GROUP_IDS=

# /api/logs 存取權杖（請求需帶 Authorization: Bearer <token>；留空則完全關閉）
ADMIN_API_TOKEN=
